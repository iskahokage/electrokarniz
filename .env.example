# Переменные окружения сайта electrokarniz.kg. Скопируйте в .env.local (разработка) или задайте на хостинге.
# Все NEXT_PUBLIC_* вшиваются в статическую сборку: после изменения нужна пересборка (npm run build).

# staging — сайт закрыт от поиска (noindex, robots.txt Disallow: /), счётчики не грузятся.
# production — индексация, sitemap в robots.txt, GA4 / Pixel / Метрика (если заданы ID ниже).
NEXT_PUBLIC_SITE_ENV=staging

# Основной адрес сайта: canonical, hreflang, sitemap.xml, OpenGraph. Без слэша в конце.
NEXT_PUBLIC_SITE_URL=https://electrokarniz.kg

# Адрес веб-приложения Google Apps Script, куда уходят заказы (пишет в таблицу «Заказы» и шлёт письмо).
NEXT_PUBLIC_ORDER_ENDPOINT=

# Опубликованная Google-таблица с ценами в формате CSV; читается только при сборке (не попадает в браузер).
PRICES_CSV_URL=

# Кыргызская версия (/ky/) в поиске. Страницы /ky/ работают всегда; в production без флага они noindex,
# без hreflang ky и вне sitemap.xml — пока владелец не проверил тексты. Поставить 1 после проверки.
NEXT_PUBLIC_KY_ENABLED=

# Демо-объекты (чужие фото) в production скрыты. 1 — временно показать их (только по решению владельца).
NEXT_PUBLIC_SHOW_DEMO=

# Google Analytics 4: идентификатор потока «G-XXXXXXXXXX».
NEXT_PUBLIC_GA_ID=

# Meta (Facebook/Instagram) Pixel: числовой ID из Events Manager.
NEXT_PUBLIC_META_PIXEL_ID=

# Яндекс Метрика: номер счётчика (только цифры).
NEXT_PUBLIC_YM_ID=
